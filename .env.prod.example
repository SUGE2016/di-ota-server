# 生产 compose 镜像（与 docker-compose.prod.yml 配合）
# 直连 GHCR（海外 / GitHub Actions 推送目标）：
OTA_IMAGE_REGISTRY=ghcr.io/suge2016
OTA_IMAGE_TAG=latest

# 国内拉取 GHCR 示例（任选其一，取消注释并注释上一行 REGISTRY）：
# 推荐优先试 DockerProxy（域名替换 ghcr.io）：
# OTA_IMAGE_REGISTRY=ghcr.dockerproxy.com/suge2016
# 备选：1ms 拉取代理（保留 ghcr.io 路径）：
# OTA_IMAGE_REGISTRY=docker.1ms.run/ghcr.io/suge2016

# 端口（按需暴露）
API_PORT=8080
CONSOLE_PORT=5173
KEYCLOAK_PORT=18080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 其余业务变量请复制 .env.example 中内容并填写生产密钥
