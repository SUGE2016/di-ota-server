# syntax=docker/dockerfile:1

ARG GO_VERSION=1.22
ARG DEBIAN_VERSION=bookworm

FROM golang:${GO_VERSION}-${DEBIAN_VERSION} AS builder
ARG GOPROXY=https://goproxy.cn,direct
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ENV GOPROXY=${GOPROXY}
WORKDIR /app
RUN sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list || true
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/ota-api ./cmd/api

FROM debian:${DEBIAN_VERSION}-slim
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
RUN sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list || true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/ota-api /usr/local/bin/ota-api
COPY migrations ./migrations
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
CMD ["ota-api"]
