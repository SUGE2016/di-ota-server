# demogo.work 生产对齐示例（复制到 /opt/di-ota/.env 并替换密钥）
OTA_IMAGE_REGISTRY=ghcr.io/suge2016
OTA_IMAGE_TAG=0.0.14

API_PORT=8080
API_AUTO_MIGRATE_ON_START=true
API_PUBLIC_BASE_URL=https://demogo.work/ota

# 设备鉴权：与生产一致
DEVICE_API_AUTH_ENABLED=true
DEVICE_AUTH_TIMESTAMP_TOLERANCE_SEC=300
DEVICE_DOWNLOAD_HMAC_ENABLED=false

# 管理台：OIDC 可选，demogo 用本地登录
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_USERNAME=admin
# bcrypt 哈希；docker compose .env 中 $ 须写成 $$
LOCAL_ADMIN_PASSWORD_HASH=$$2a$$12$$...

OIDC_ENABLED=false
OIDC_MOCK_ENABLED=false

# 其余 POSTGRES / JWT / S3 / MINIO 等见 .env.example
